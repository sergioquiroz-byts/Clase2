          "raw": "{\n  \"fecha\": \"2026-11-03\",\n  \"texto\": \"Hola, esta es una carta de prueba.\",\n  \"remitente\": \"Juan\",\n  \"destinatario\": \"María\",\n  \"direccion\": \"Calle 10 # 5-20, Sevilla\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
